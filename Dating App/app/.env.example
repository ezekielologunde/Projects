# Copy to .env.local and fill in. Never commit .env.local (see spec section 9.7).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never exposed to the browser. Used only by the upload-processing
# route and the cron purge route (spec section 4.2, 9.7).
SUPABASE_SECRET_KEY=

# Bearer secret checked by /api/cron/* routes.
CRON_SECRET=

# Set once Google OAuth and Turnstile are configured in the Supabase dashboard (Phase 1).
